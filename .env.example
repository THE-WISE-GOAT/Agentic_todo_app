# Copy to .env and adjust as needed. All values are optional.

# SQLite path. Defaults to todos.db next to this file.
DATABASE_URL=sqlite:///./todos.db

# Ollama, used by the Ask tab.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Comma-separated origins, only needed when calling the API from another site.
CORS_ORIGINS=
